{
  "expo": {
    "name": "CipherLink",
    "slug": "cipherlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cipherlink",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android"],
    "newArchEnabled": true,
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cipherlink.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "CipherLink uses Face ID to protect your encryption keys."
      }
    },
    "android": {
      "package": "com.cipherlink.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a1a"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a1a"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-splash-screen", {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#0a0a1a",
        "resizeMode": "contain"
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "cipherlink"
      }
    }
  }
}
